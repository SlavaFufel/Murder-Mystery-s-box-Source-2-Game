@code {
    public enum State { Idle, Rolling, Result }

    public class StripEntry
    {
        public string CosmeticId;
        public string IconPath;
        public string Emoji;
    }

    // Глобальный одиночка — UI читает поля и решает, рисовать ли себя.
    public static bool IsOpenStatic { get; set; } = false;
    public static string OpenedCaseId { get; set; } = "";

    private bool IsOpen => IsOpenStatic && !string.IsNullOrEmpty( OpenedCaseId );

    private State _state = State.Idle;
    private readonly List<StripEntry> _stripItems = new();
    private int _winnerIndex = 0;
    private string _resultItemId = "";

    // Zoom-попап выбранной карточки в drops-сетке (клик по drop-cell).
    private DropChance _zoom;
    private void OpenZoom( DropChance d ) { _zoom = d; }
    private void CloseZoom() { _zoom = null; }
    /// <summary>
    /// Пустой обработчик на саму панель попапа — чтобы клик по самой панели
    /// не пробулькивал в overlay и не закрывал попап. Закрытие — только клик
    /// по фону или крестик ✕ или ESC.
    /// </summary>
    private void SwallowClick() { }

    // Параметры анимации.
    private const int StripCellsBefore = 30;  // сколько ячеек идёт до выигрышной
    private const int StripCellsAfter = 8;    // запас после, чтобы линия не обрывалась у победителя
    private const float CellWidth = 126f;     // 120 + 6 gap
    private const float SpinDuration = 5.0f;

    private float _spinStart;
    private float _spinEndOffset;       // offset (px) where the strip stops — winner under pointer
    private float _spinJitter;          // случайный сдвиг ±40px, добавляется к финальному offset
    private int _lastSeenRollCounter = -1;
    private int _lastTickCellIndex = 0; // сколько ячеек уже прошло под маркером — для тика
    private const string TickSound = "sounds/shop/tick.sound.sound";
    private Panel _stripWindow;

    /// <summary>Фактическая половина ширины окна прокрутки (для совмещения с маркером 50%).</summary>
    private float WindowCenterPx
    {
        get
        {
            float w = _stripWindow != null ? _stripWindow.Box.Rect.Width : 0f;
            // ScreenScale: Box.Rect в физических пикселях, а left/transform CSS — в логических.
            float scale = _stripWindow != null ? _stripWindow.ScaleFromScreen : 1f;
            if ( w <= 0f ) return 380f; // fallback до первого layout
            return w * scale * 0.5f;
        }
    }

    private PlayerStats LocalPlayer =>
        Scene?.GetAllComponents<PlayerStats>().FirstOrDefault( p => !p.IsProxy );

    private int OwnedCount => LocalPlayer?.GetCaseCount( OpenedCaseId ) ?? 0;

    public static void Open( string caseId )
    {
        IsOpenStatic = true;
        OpenedCaseId = caseId ?? "";
    }

    private void Close()
    {
        IsOpenStatic = false;
        OpenedCaseId = "";
        _state = State.Idle;
        _stripItems.Clear();
        _resultItemId = "";
    }

    private CaseDefinition FindCaseDefinition( string caseId )
    {
        if ( string.IsNullOrEmpty( caseId ) ) return null;
        // Стартовый кейс определён в коде — не ищем у вендоров.
        var starter = StarterCase.Get( caseId );
        if ( starter != null ) return starter;
        if ( Scene == null ) return null;
        foreach ( var v in Scene.GetAllComponents<CosmeticVendorNPC>() )
        {
            if ( v.Cases == null ) continue;
            var d = v.Cases.FirstOrDefault( c => c.Id == caseId );
            if ( d != null ) return d;
        }
        return null;
    }

    private string GetCaseIconPath()
    {
        var def = FindCaseDefinition( OpenedCaseId );
        return def?.IconPath ?? "";
    }

    /// <summary>Закрытая картинка для Idle, открытая — для Rolling/Result.</summary>
    private string GetCurrentCaseIconPath()
    {
        var def = FindCaseDefinition( OpenedCaseId );
        if ( def == null ) return "";
        if ( _state == State.Idle ) return def.IconPath ?? "";
        var opened = string.IsNullOrEmpty( def.OpenedIconPath ) ? def.IconPath : def.OpenedIconPath;
        return opened ?? "";
    }

    /// <summary>CSS-класс для контейнера .case-image — добавляет тряску/свечение по состоянию.</summary>
    private string GetCaseImageClass()
    {
        return _state switch
        {
            State.Rolling => "case-rolling",
            State.Result  => "case-opened",
            _ => "case-idle"
        };
    }

    private string GetCaseNameKey()
    {
        var def = FindCaseDefinition( OpenedCaseId );
        return def?.NameKey ?? ("case." + OpenedCaseId);
    }

    private string GetItemNameKey( string itemId )
    {
        // Currency-дроп с произвольным номиналом (CaseDropEntry.CrystalsAmount):
        // нет записи в каталоге, но имя нужно человекочитаемое.
        if ( TryParseSyntheticCurrency( itemId, out int amount ) )
            return $"◆ +{amount}";
        var item = CosmeticCatalog.Get( itemId );
        return item?.NameKey ?? itemId;
    }

    /// <summary>
    /// Парсит синтетический id вида "crystals_250" (формируется в playerstats
    /// RequestOpenCase для дропов с CrystalsAmount > 0). Возвращает true и
    /// сумму, если формат совпал.
    /// </summary>
    private static bool TryParseSyntheticCurrency( string id, out int amount )
    {
        amount = 0;
        if ( string.IsNullOrEmpty( id ) ) return false;
        const string prefix = "crystals_";
        if ( !id.StartsWith( prefix, System.StringComparison.Ordinal ) ) return false;
        return int.TryParse( id.AsSpan( prefix.Length ), out amount ) && amount > 0;
    }

    private string EmojiFor( string itemId )
    {
        var item = CosmeticCatalog.Get( itemId );
        return item != null ? CosmeticCatalog.SlotEmoji( item.Slot ) : "?";
    }

    private string IconPathFor( string itemId )
    {
        var item = CosmeticCatalog.Get( itemId );
        return item?.IconPath ?? "";
    }

    /// <summary>Простая запись для UI: id или сумма кристаллов + посчитанный шанс в %.</summary>
    public class DropChance
    {
        public string CosmeticId;
        public int    CrystalsAmount;  // если > 0 — это currency-дроп без CosmeticCatalog-записи
        public float  ChancePercent;
    }

    private static bool IsValidDropEntry( CaseDropEntry d )
        => d != null && d.Weight > 0f && (!string.IsNullOrEmpty( d.CosmeticId ) || d.CrystalsAmount > 0);

    // Редкость drop'а для сортировки превью-сетки. Currency-дропы без CosmeticId
    // (просто CrystalsAmount) — Common (так же как в рендере карточки выше).
    private static CosmeticCatalog.Rarity GetDropRarity( CaseDropEntry d )
    {
        if ( d == null ) return CosmeticCatalog.Rarity.Common;
        if ( d.CrystalsAmount > 0 && string.IsNullOrEmpty( d.CosmeticId ) )
            return CosmeticCatalog.Rarity.Common;
        var item = CosmeticCatalog.Get( d.CosmeticId );
        return item != null ? item.Rarity : CosmeticCatalog.Rarity.Common;
    }

    /// <summary>
    /// Возвращает список возможных дропов из текущего кейса с шансами в %,
    /// отсортированный по убыванию шанса. Используется для блока «Возможные награды».
    /// </summary>
    private IEnumerable<DropChance> DropsWithChances()
    {
        var def = FindCaseDefinition( OpenedCaseId );
        if ( def == null || def.Drops == null ) yield break;

        float total = 0f;
        foreach ( var d in def.Drops )
            if ( IsValidDropEntry( d ) ) total += d.Weight;
        if ( total <= 0f ) yield break;

        // Сортируем сначала по редкости (Legendary → Common), внутри редкости
        // по весу (самые вероятные первыми). Так превью-сетка идёт «топовые
        // награды сверху», и одинаковые по редкости группируются.
        var sorted = def.Drops
            .Where( IsValidDropEntry )
            .OrderByDescending( d => (int)GetDropRarity( d ) )
            .ThenByDescending( d => d.Weight );

        foreach ( var d in sorted )
        {
            yield return new DropChance
            {
                CosmeticId     = d.CosmeticId,
                CrystalsAmount = d.CrystalsAmount,
                ChancePercent  = d.Weight / total * 100f,
            };
        }
    }

    private void Spin()
    {
        var p = LocalPlayer;
        var vendor = CosmeticVendorNPC.ActiveForLocal;
        if ( p == null ) return;
        if ( OwnedCount <= 0 ) return;

        // Запросить ролл у себя (Owner authority). Если NPC рядом нет — отдадим Empty,
        // playerstats найдёт case definition в любом NPC сцены.
        var vendorId = vendor != null ? vendor.GameObject.Id : System.Guid.Empty;
        _lastSeenRollCounter = p.LastRollCounter;
        p.RequestOpenCase( vendorId, OpenedCaseId );
        // _state переключится в Rolling в OnUpdate, когда увидим инкремент LastRollCounter
        // (значит сервер выкатил предмет). Тут только пометим что ждём.
    }

    private void Claim()
    {
        Close();
    }

    private void OpenAnother()
    {
        _state = State.Idle;
        _stripItems.Clear();
        _resultItemId = "";
    }

    /// <summary>Собрать полоску для прокрутки. Заполняем случайными дропами кейса, в позицию StripCellsBefore — победителя.</summary>
    private void BuildStrip( string winnerItemId )
    {
        _stripItems.Clear();
        _winnerIndex = StripCellsBefore;

        var def = FindCaseDefinition( OpenedCaseId );
        var pool = new List<string>();
        if ( def != null && def.Drops != null )
            foreach ( var d in def.Drops )
            {
                if ( !IsValidDropEntry( d ) ) continue;
                // Для currency-дропов с произвольным CrystalsAmount синтезируем id
                // вида "crystals_N", чтобы в strip-cell он отрисовался как currency.
                pool.Add( !string.IsNullOrEmpty( d.CosmeticId )
                    ? d.CosmeticId
                    : $"crystals_{d.CrystalsAmount}" );
            }
        if ( pool.Count == 0 ) pool.Add( winnerItemId );

        var rng = new System.Random();
        for ( int i = 0; i < StripCellsBefore + StripCellsAfter + 1; i++ )
        {
            string id = i == _winnerIndex
                ? winnerItemId
                : pool[rng.Next( pool.Count )];
            _stripItems.Add( new StripEntry
            {
                CosmeticId = id,
                IconPath = IconPathFor( id ),
                Emoji = EmojiFor( id ),
            } );
        }
    }

    /// <summary>Текущий стиль для .strip-row (left: -px) — реализуем плавное замедление вручную через easing.</summary>
    private string StripStyle()
    {
        // Финальный offset считается динамически: cellCenter - реальный центр окна + jitter.
        // Это нужно потому что .strip-window имеет max-width:100% и фактически бывает уже 760px.
        float winnerCellCenter = _winnerIndex * CellWidth + 60f;
        float endOffset = winnerCellCenter - WindowCenterPx + _spinJitter;
        _spinEndOffset = endOffset; // запоминаем для проверки тиков

        float current;
        if ( _state == State.Idle )
            current = 0f;
        else if ( _state == State.Result )
            current = endOffset;
        else
        {
            float raw = ( Time.Now - _spinStart ) / SpinDuration;
            float t = raw < 0f ? 0f : ( raw > 1f ? 1f : raw );
            // ease-out cubic
            float inv = 1f - t;
            float eased = 1f - inv * inv * inv;
            current = eased * endOffset;
        }
        return $"left: -{current.ToString( "F1", System.Globalization.CultureInfo.InvariantCulture )}px;";
    }

    protected override void OnUpdate()
    {
        if ( !IsOpen ) return;

        // ESC закрывает zoom-попап (если он открыт). Не пропускаем ESC дальше —
        // иначе сразу же откроется главное menu, которое перекроет всё.
        if ( _zoom != null && Input.EscapePressed )
        {
            _zoom = null;
            Input.EscapePressed = false;
            return;
        }

        var p = LocalPlayer;
        if ( p == null ) return;

        if ( _lastSeenRollCounter < 0 )
            _lastSeenRollCounter = p.LastRollCounter;

        // Сервер выдал результат — стартуем анимацию.
        if ( _state == State.Idle && p.LastRollCounter > _lastSeenRollCounter && p.LastRolledCaseId == OpenedCaseId )
        {
            _resultItemId = p.LastRolledItemId;
            BuildStrip( _resultItemId );
            // Случайный сдвиг ±40px чтобы остановка не была идеально по центру каждый раз.
            // Сам endOffset считается в StripStyle() с учётом фактической ширины окна.
            var rng = new System.Random();
            _spinJitter = (float)( rng.NextDouble() * 80.0 - 40.0 );
            _spinStart = Time.Now;
            _state = State.Rolling;
            _lastSeenRollCounter = p.LastRollCounter;
            _lastTickCellIndex = 0;
        }
        else if ( _state == State.Rolling )
        {
            // Тик: считаем сколько ячеек уже прошло центральный маркер.
            // current — тот же расчёт, что в StripStyle().
            float raw = ( Time.Now - _spinStart ) / SpinDuration;
            float t = raw < 0f ? 0f : ( raw > 1f ? 1f : raw );
            float inv = 1f - t;
            float eased = 1f - inv * inv * inv;
            float current = eased * _spinEndOffset;
            // Каждые CellWidth пикселей сдвига = одна пройденная ячейка.
            int crossed = (int)( current / CellWidth );
            if ( crossed > _lastTickCellIndex )
            {
                _lastTickCellIndex = crossed;
                // Тик прокрутки кейса звучит десятки раз за рулёт — играем
                // тихо относительно общего SFX, чтобы не оглушало.
                Sfx.Play( TickSound, 0.12f );
            }

            if ( Time.Now - _spinStart >= SpinDuration )
                _state = State.Result;
        }

        if ( Input.EscapePressed )
        {
            if ( _state != State.Rolling )
            {
                Close();
                Input.EscapePressed = false;
            }
        }
    }

    protected override int BuildHash()
    {
        var p = LocalPlayer;
        // тикаем по времени во время анимации, чтобы перерисовать strip-row left
        int tick = _state == State.Rolling ? (int)( ( Time.Now - _spinStart ) * 60f ) : 0;
        int part = System.HashCode.Combine( IsOpen, OpenedCaseId, _state, _winnerIndex, _stripItems.Count );
        return System.HashCode.Combine(
            part,
            p?.LastRollCounter ?? 0,
            p?.GetCaseCount( OpenedCaseId ) ?? 0,
            tick,
            L.Version
        );
    }
}
