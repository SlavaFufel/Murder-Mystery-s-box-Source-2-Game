@using Sandbox;
@using Sandbox.UI;
@using System;
@using System.Linq;
@using System.Collections.Generic;

@inherits PanelComponent

@*
    CS:GO-style case opening:
    Idle  → пользователь открыл и видит «прокрутить»
    Rolling → анимация бегущей полоски, выпадает то, что сервер уже выкатил
    Result → показ выпавшего предмета + кнопка Claim → закрыть и вернуться в инвентарь.
*@

<root>
    @if ( IsOpen && LocalPlayer != null )
    {
        <div class="overlay">
            <div class="panel">
                <div class="header">
                    <div class="header-titles">
                        <div class="eyebrow">@L.T("inventory.tab.cases")</div>
                        <div class="title">@L.T(GetCaseNameKey())</div>
                    </div>
                    <div class="close" onclick=@Close>✕</div>
                </div>

                <div class="case-image @GetCaseImageClass()">
                    @if ( !string.IsNullOrEmpty(GetCurrentCaseIconPath()) )
                    {
                        <img src="@GetCurrentCaseIconPath()" />
                    }
                    else
                    {
                        <div class="case-image-fallback">▣</div>
                    }
                    @if ( _state == State.Rolling || _state == State.Result )
                    {
                        <div class="case-glow"></div>
                    }
                </div>

                <div class="strip-frame">
                    <div class="strip-window" @ref="_stripWindow">
                        <div class="strip-row" style="@StripStyle()">
                            @for ( int i = 0; i < _stripItems.Count; i++ )
                            {
                                var entry = _stripItems[i];
                                bool isWinner = _state == State.Result && i == _winnerIndex;
                                // Синтетический "crystals_N" id (currency-дроп через CaseDropEntry.CrystalsAmount).
                                bool isSynthCurrency = TryParseSyntheticCurrency( entry.CosmeticId, out int synthAmount );
                                var item = isSynthCurrency ? null : CosmeticCatalog.Get( entry.CosmeticId );
                                var rarityHex = isSynthCurrency
                                    ? CosmeticCatalog.RarityHexColor( CosmeticCatalog.Rarity.Common )
                                    : (item != null ? CosmeticCatalog.RarityHexColor( item.Rarity ) : "#6b727d");
                                var glowSize = isWinner ? "16" : "4";
                                var glowColor = isWinner ? rarityHex : (rarityHex + "33");
                                var cellStyle = $"border-color: {rarityHex}; box-shadow: 0 0 {glowSize}px {glowColor};";
                                <div class="strip-cell @(isWinner ? "winner" : "")" style="@cellStyle">
                                    @if ( isSynthCurrency )
                                    {
                                        <div class="strip-currency">◆ +@synthAmount</div>
                                    }
                                    else if ( !string.IsNullOrEmpty(entry.IconPath) )
                                    {
                                        <img src="@entry.IconPath" />
                                    }
                                    else if ( item != null && item.Slot == CosmeticCatalog.Slot.Nickname )
                                    {
                                        <div class="nick @item.ResourceRef">@L.T(item.NameKey)
                                            @if ( item.ResourceRef == "nick-blood" ) {
                                                <div class="blood-drop bd1"></div>
                                                <div class="blood-drop bd2"></div>
                                                <div class="blood-drop bd3"></div>
                                            }
                                        </div>
                                    }
                                    else if ( item != null && item.Slot == CosmeticCatalog.Slot.Currency )
                                    {
                                        <div class="strip-currency">◆ +@item.ResourceRef</div>
                                    }
                                    else
                                    {
                                        <div class="strip-cell-fallback">@entry.Emoji</div>
                                    }
                                </div>
                            }
                        </div>
                        @* Центральный маркер — стрелки + вертикальная линия-прицел *@
                        <div class="strip-marker">
                            <div class="strip-marker-arrow top">▼</div>
                            <div class="strip-marker-line"></div>
                            <div class="strip-marker-arrow bottom">▲</div>
                        </div>
                    </div>
                </div>

                <div class="controls">
                    @if ( _state == State.Idle )
                    {
                        @if ( OwnedCount > 0 )
                        {
                            <div class="btn btn-primary" onclick=@Spin>@L.T("case_open.btn.spin")</div>
                            <div class="hint">@L.T("case_open.hint.have_n", OwnedCount)</div>
                        }
                        else
                        {
                            <div class="btn btn-disabled">@L.T("case_open.empty")</div>
                        }
                    }
                    else if ( _state == State.Rolling )
                    {
                        <div class="btn btn-disabled">@L.T("case_open.btn.rolling")</div>
                    }
                    else if ( _state == State.Result )
                    {
                        <div class="result-name">@L.T(GetItemNameKey(_resultItemId))</div>
                        <div class="result-buttons">
                            <div class="btn btn-success" onclick=@Claim>@L.T("case_open.btn.claim")</div>
                            @if ( OwnedCount > 0 )
                            {
                                <div class="btn btn-secondary" onclick=@OpenAnother>@L.T("case_open.btn.open_another")</div>
                            }
                        </div>
                    }
                </div>

                @* ── Возможные дропы (Standoff-style сетка) — видны в Idle и Rolling ── *@
                @if ( _state != State.Result )
                {
                    <div class="drops-block">
                        <div class="drops-title">@L.T("case_open.drops_title")</div>
                        <div class="drops-grid">
                            @foreach ( var d in DropsWithChances() )
                            {
                                // Currency-дроп с произвольным номиналом (CrystalsAmount > 0
                                // в CaseDropEntry) не имеет записи в CosmeticCatalog — рендерим
                                // напрямую как «◆ +N». Обычные дропы — как раньше через catalog.
                                bool isCurrencyAmount = d.CrystalsAmount > 0;
                                var item       = isCurrencyAmount ? null : CosmeticCatalog.Get( d.CosmeticId );
                                var rarityHex  = isCurrencyAmount
                                    ? CosmeticCatalog.RarityHexColor( CosmeticCatalog.Rarity.Common )
                                    : (item != null ? CosmeticCatalog.RarityHexColor( item.Rarity ) : "#6b727d");
                                var cellStyle  = "border-color: " + rarityHex + ";";
                                var chanceText = d.ChancePercent.ToString( "F1", System.Globalization.CultureInfo.InvariantCulture ) + "%";
                                var displayName = isCurrencyAmount
                                    ? $"◆ +{d.CrystalsAmount}"
                                    : (item != null ? L.T( item.NameKey ) : d.CosmeticId);

                                var localD = d; // захват для лямбды клика — копия в локальную переменную, чтобы каждая ячейка передавала свой drop
                                <div class="drop-cell" style="@cellStyle" onclick=@(() => OpenZoom(localD))>
                                    <div class="drop-chance-badge">@chanceText</div>
                                    <div class="drop-cell-icon">
                                        @if ( isCurrencyAmount )
                                        {
                                            <div class="drop-currency">◆ +@d.CrystalsAmount</div>
                                        }
                                        else if ( item != null && !string.IsNullOrEmpty( item.IconPath ) )
                                        {
                                            <img src="@item.IconPath" />
                                        }
                                        else if ( item != null && item.Slot == CosmeticCatalog.Slot.Nickname )
                                        {
                                            <div class="nick mini @item.ResourceRef">@displayName
                                                @if ( item.ResourceRef == "nick-blood" ) {
                                                    <div class="blood-drop bd1"></div>
                                                    <div class="blood-drop bd2"></div>
                                                    <div class="blood-drop bd3"></div>
                                                }
                                            </div>
                                        }
                                        else if ( item != null && item.Slot == CosmeticCatalog.Slot.Currency )
                                        {
                                            <div class="drop-currency">◆ +@item.ResourceRef</div>
                                        }
                                        else
                                        {
                                            <div class="drop-emoji">@(item != null ? CosmeticCatalog.SlotEmoji( item.Slot ) : "?")</div>
                                        }
                                    </div>
                                    <div class="drop-cell-name">@displayName</div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @* ── Zoom-попап: большая картинка выбранного дропа (клик по drop-cell) ── *@
    @if ( IsOpen && _zoom != null )
    {
        bool zoomIsCurrency = _zoom.CrystalsAmount > 0;
        var zoomItem = zoomIsCurrency ? null : CosmeticCatalog.Get( _zoom.CosmeticId );
        var zoomRarityHex = zoomIsCurrency
            ? CosmeticCatalog.RarityHexColor( CosmeticCatalog.Rarity.Common )
            : (zoomItem != null ? CosmeticCatalog.RarityHexColor( zoomItem.Rarity ) : "#6b727d");
        var zoomRarityKey = zoomIsCurrency
            ? CosmeticCatalog.RarityKey( CosmeticCatalog.Rarity.Common )
            : (zoomItem != null ? CosmeticCatalog.RarityKey( zoomItem.Rarity ) : "rarity.common");
        var zoomName = zoomIsCurrency
            ? $"◆ +{_zoom.CrystalsAmount}"
            : (zoomItem != null ? L.T( zoomItem.NameKey ) : _zoom.CosmeticId);
        var zoomChance = _zoom.ChancePercent.ToString( "F1", System.Globalization.CultureInfo.InvariantCulture ) + "%";

        <div class="zoom-overlay" onclick=@CloseZoom>
            <div class="zoom-panel" style="border-color: @zoomRarityHex;" onclick=@SwallowClick>
                <div class="zoom-close" onclick=@CloseZoom>✕</div>
                <div class="zoom-rarity" style="color: @zoomRarityHex;">@L.T(zoomRarityKey)</div>
                <div class="zoom-stage">
                    @if ( zoomIsCurrency )
                    {
                        <div class="zoom-currency">◆ +@_zoom.CrystalsAmount</div>
                    }
                    else if ( zoomItem != null && !string.IsNullOrEmpty( zoomItem.IconPath ) )
                    {
                        <img class="zoom-img" src="@zoomItem.IconPath" />
                    }
                    else if ( zoomItem != null && zoomItem.Slot == CosmeticCatalog.Slot.Nickname )
                    {
                        <div class="nick big @zoomItem.ResourceRef">@zoomName
                            @if ( zoomItem.ResourceRef == "nick-blood" ) {
                                <div class="blood-drop bd1"></div>
                                <div class="blood-drop bd2"></div>
                                <div class="blood-drop bd3"></div>
                            }
                        </div>
                    }
                    else if ( zoomItem != null && zoomItem.Slot == CosmeticCatalog.Slot.Currency )
                    {
                        <div class="zoom-currency">◆ +@zoomItem.ResourceRef</div>
                    }
                    else
                    {
                        <div class="zoom-emoji">@(zoomItem != null ? CosmeticCatalog.SlotEmoji( zoomItem.Slot ) : "?")</div>
                    }
                </div>
                <div class="zoom-name">@zoomName</div>
                <div class="zoom-chance">@zoomChance</div>
            </div>
        </div>
    }
</root>

<style>
    *:active { sound-in: "sounds/tap/tap.sound"; }

    /* ── Design tokens (sync with Code/UI/Design.cs) ──
       bg-0 #0b0d10  bg-1 #101317  bg-2 #161a20
       border rgba(255,255,255,0.10)
       text-1 #e7eaee  text-2 #a8b0bb  text-3 #6b727d
       accent #5ea3ff  success #4ec07a  warning #e6b454  danger #e05c5c
       r-sm 6px  r-md 12px
    */

    root {
        position: absolute;
        width: 100%;
        height: 100%;
        pointer-events: none;
        font-family: Inter, Roboto, sans-serif;
        color: #e7eaee;
    }

    .overlay {
        position: absolute;
        width: 100%;
        height: 100%;
        background-color: rgba(11,13,16,0.78);
        backdrop-filter: blur(8px);
        align-items: center;
        justify-content: center;
        pointer-events: all;
    }

    .panel {
        flex-direction: column;
        width: 880px;
        max-width: 92%;
        padding: 20px 24px;
        background-color: #101317;
        border: 1px solid rgba(255,255,255,0.10);
        border-radius: 12px;
        gap: 16px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.4);
        align-items: center;
    }

    /* ── Header ── */
    .header {
        flex-direction: row;
        width: 100%;
        align-items: center;
        justify-content: space-between;
        padding-bottom: 12px;
        border-bottom: 1px solid rgba(255,255,255,0.06);
    }
    .header-titles { flex-direction: column; gap: 2px; }
    .eyebrow {
        color: #6b727d;
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 0.5px;
        text-transform: uppercase;
    }
    .title {
        color: #e7eaee;
        font-size: 16px;
        font-weight: 700;
    }
    .close {
        padding: 4px 10px;
        background-color: transparent;
        border: 1px solid rgba(255,255,255,0.10);
        border-radius: 6px;
        color: #6b727d;
        font-size: 14px;
        cursor: pointer;
        transition: background-color 0.12s, color 0.12s;
    }
    .close:hover { color: #e7eaee; background-color: #161a20; }

    /* ── Case image (with shake/glow animations preserved) ── */
    .case-image {
        width: 200px;
        height: 200px;
        background-color: #0b0d10;
        border: 1px solid rgba(255,255,255,0.10);
        border-radius: 12px;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        position: relative;
        transition: all 0.4s ease-out;
    }
    .case-image img { width: 190px; height: 190px; }
    .case-image.case-idle img { margin-top: -16px; }
    .case-image-fallback {
        font-size: 72px;
        color: #3f4550;
    }
    /* Rolling: cyan accent glow + shake (animation preserved) */
    .case-image.case-rolling {
        animation: case-shake 0.18s ease-in-out infinite;
        border-color: #5ea3ff;
        box-shadow: 0 0 24px rgba(94,163,255,0.6);
    }
    /* Opened: amber "victory" glow + scale up (animation preserved) */
    .case-image.case-opened {
        border-color: #e6b454;
        box-shadow: 0 0 32px rgba(230,180,84,0.7);
        transform: scale(1.04);
    }
    @@keyframes case-shake {
        0%   { transform: translate(0, 0) rotate(0deg); }
        25%  { transform: translate(-3px, 1px) rotate(-1deg); }
        50%  { transform: translate(3px, -1px) rotate(1deg); }
        75%  { transform: translate(-2px, 2px) rotate(-0.5deg); }
        100% { transform: translate(0, 0) rotate(0deg); }
    }
    /* CSS-only glow ring behind the open case */
    .case-glow {
        position: absolute;
        width: 260px;
        height: 260px;
        top: -30px;
        left: -30px;
        background-color: rgba(94,163,255,0.16);
        border-radius: 50%;
        animation: case-pulse 1.4s ease-in-out infinite;
        pointer-events: none;
    }
    @@keyframes case-pulse {
        0%, 100% { opacity: 0.5; transform: scale(1); }
        50%      { opacity: 1; transform: scale(1.15); }
    }

    /* ── Strip carousel (animation preserved) ── */
    .strip-frame {
        flex-direction: column;
        width: 760px;
        max-width: 100%;
        position: relative;
        align-items: center;
    }

    .strip-window {
        width: 760px;
        max-width: 100%;
        height: 140px;
        background-color: #0b0d10;
        border: 1px solid rgba(255,255,255,0.10);
        border-radius: 12px;
        overflow: hidden;
        position: relative;
    }

    .strip-row {
        position: absolute;
        top: 10px;
        left: 0;
        flex-direction: row;
        height: 120px;
        gap: 6px;
    }

    .strip-cell {
        width: 120px;
        height: 120px;
        background-color: #161a20;
        border: 1px solid rgba(255,255,255,0.10);
        border-radius: 6px;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        overflow: hidden;
    }
    .strip-cell img { width: 110px; height: 110px; }
    .strip-cell-fallback {
        font-size: 56px;
        color: #6b727d;
    }
    .strip-currency {
        font-size: 18px;
        font-weight: 700;
        color: #5ea3ff;
        text-align: center;
    }
    .strip-cell.winner {
        border: 2px solid #5ea3ff;
        background-color: rgba(94,163,255,0.12);
    }

    /* Center marker: vertical line + arrows above/below */
    .strip-marker {
        position: absolute;
        left: 50%;
        top: 0px;
        width: 2px;
        height: 140px;
        transform: translateX(-50%);
        z-index: 20;
        pointer-events: none;
    }
    .strip-marker-line {
        position: absolute;
        left: 0px;
        top: 22px;
        bottom: 22px;
        width: 2px;
        background-color: rgba(94,163,255,0.8);
    }
    .strip-marker-arrow {
        position: absolute;
        left: 50%;
        transform: translateX(-50%);
        color: #5ea3ff;
        font-size: 18px;
        line-height: 1;
    }
    .strip-marker-arrow.top    { top: 2px; }
    .strip-marker-arrow.bottom { bottom: 2px; }

    /* ── Controls ── */
    .controls {
        flex-direction: column;
        align-items: center;
        gap: 10px;
        min-height: 60px;
    }
    .btn {
        padding: 12px 32px;
        border-radius: 6px;
        font-size: 14px;
        font-weight: 700;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        cursor: pointer;
        transition: background-color 0.12s, border-color 0.12s, color 0.12s;
    }
    .btn-primary {
        background-color: #5ea3ff;
        border: 1px solid #5ea3ff;
        color: #0b0d10;
    }
    .btn-primary:hover  { background-color: #7eb6ff; border-color: #7eb6ff; }
    .btn-primary:active { background-color: #3f8ce8; border-color: #3f8ce8; }
    .btn-success {
        background-color: #4ec07a;
        border: 1px solid #4ec07a;
        color: #0b0d10;
    }
    .btn-success:hover { background-color: #62d18b; border-color: #62d18b; }
    .btn-secondary {
        background-color: transparent;
        border: 1px solid rgba(94,163,255,0.45);
        color: #5ea3ff;
    }
    .btn-secondary:hover {
        background-color: rgba(94,163,255,0.10);
        border-color: rgba(94,163,255,0.6);
    }
    .btn-disabled {
        padding: 12px 32px;
        border-radius: 6px;
        font-size: 14px;
        font-weight: 500;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        background-color: transparent;
        border: 1px solid rgba(255,255,255,0.10);
        color: #6b727d;
        cursor: default;
    }

    .result-buttons {
        flex-direction: row;
        gap: 10px;
        justify-content: center;
        align-items: center;
    }

    .hint {
        color: #6b727d;
        font-size: 12px;
        font-weight: 500;
        letter-spacing: 0.5px;
    }

    .result-name {
        color: #e7eaee;
        font-size: 18px;
        font-weight: 700;
    }

    /* ── Ник-метки (косметика — не minimal chrome, оставлены как есть) ── */
    .nick {
        font-size: 14px;
        font-weight: 700;
        letter-spacing: 1px;
        padding: 3px 10px;
        border-radius: 8px;
        color: white;
        background-color: rgba(0,0,0,0.55);
        border: 1px solid rgba(255,255,255,0.18);
        text-shadow: 0 1px 2px rgba(0,0,0,0.9);
        position: relative;
        text-align: center;
    }
    .nick.mini {
        font-size: 12px;
        letter-spacing: 0.5px;
        padding: 3px 8px;
        border-radius: 4px;
        max-width: 100px;
    }
    /* Большая версия — для zoom-попапа. Шрифт побольше, чтобы было читаемо. */
    .nick.big {
        font-size: 28px;
        letter-spacing: 1.5px;
        padding: 12px 24px;
        border-radius: 8px;
        max-width: 460px;
    }
    .blood-drop {
        position: absolute;
        background-color: #8a0303;
        width: 3px;
        border-radius: 0 0 3px 3px;
        pointer-events: none;
        bottom: -2px;
        height: 2px;
    }
    .blood-drop.bd1 { left: 20%; animation: blood-drip 2.0s ease-in 0s infinite; }
    .blood-drop.bd2 { left: 52%; animation: blood-drip 2.5s ease-in 0.8s infinite; }
    .blood-drop.bd3 { left: 76%; animation: blood-drip 1.9s ease-in 1.4s infinite; }
    @@keyframes blood-drip {
        0%   { height: 2px; opacity: 0.9; transform: translateY(0); }
        25%  { height: 7px; }
        75%  { opacity: 0.7; }
        100% { height: 8px; transform: translateY(24px); opacity: 0; }
    }
    .nick-default {}
    .nick-chalk      { color: #f0f0f0; font-family: "Comic Sans MS", "Marker Felt", cursive; text-shadow: 0 0 1px rgba(255,255,255,0.4); }
    .nick-typewriter { color: #1a1a1a; background-color: rgba(245,245,235,0.92); font-family: "Courier New", monospace; border: 1px solid #555; }
    .nick-cinema     { color: #ffe9b8; font-style: italic; text-shadow: 2px 2px 4px rgba(0,0,0,1); }
    .nick-neon-blue  { color: #a8efff; background-color: rgba(0,15,30,0.7); border: 1px solid rgba(80,200,255,0.7); text-shadow: 0 0 8px #4ad8ff, 0 0 16px #4ad8ff; animation: nick-neon-pulse 1.4s ease-in-out infinite; }
    .nick-neon-pink  { color: #ffb8e6; background-color: rgba(30,0,20,0.7); border: 1px solid rgba(255,80,200,0.7); text-shadow: 0 0 8px #ff4ad8, 0 0 16px #ff4ad8; animation: nick-neon-pulse 1.6s ease-in-out infinite; }
    .nick-police     { color: white; background: linear-gradient(90deg, rgba(220,40,40,0.85) 0%, rgba(40,80,220,0.85) 100%); border: 1px solid rgba(255,255,255,0.5); animation: nick-police-flash 0.9s ease-in-out infinite; }
    .nick-glitch     { color: #cffafa; background-color: rgba(0,0,0,0.78); border: 1px solid rgba(255,80,180,0.6); text-shadow: 2px 0 0 #ff00aa, -2px 0 0 #00ffff; animation: nick-glitch-shake 0.45s infinite; }
    .nick-blood      { color: #ff4040; background-color: rgba(20,0,0,0.85); border: 1px solid rgba(255,40,40,0.7); text-shadow: 0 0 6px #c00000, 0 2px 4px rgba(120,0,0,0.9); animation: nick-blood-pulse 1.8s ease-in-out infinite; }
    .nick-ghost      { color: rgba(220,235,255,0.85); background-color: rgba(40,50,80,0.4); border: 1px solid rgba(180,200,255,0.4); text-shadow: 0 0 8px rgba(200,220,255,0.7); animation: nick-ghost-fade 2.4s ease-in-out infinite; }
    .nick-suspect    { color: #ffd700; background-color: rgba(40,30,0,0.85); border: 2px solid rgba(255,215,0,0.85); text-shadow: 0 0 10px #ffaa00, 0 0 20px #ffd700; animation: nick-suspect-shine 2s ease-in-out infinite; }
    .nick-justice    { color: #fff7c0; background: linear-gradient(90deg, rgba(80,60,0,0.85), rgba(180,140,0,0.85), rgba(80,60,0,0.85)); border: 2px solid #ffd700; text-shadow: 0 0 10px #ffd700, 0 0 18px #ffaa00; animation: nick-justice-shimmer 1.6s ease-in-out infinite; }
