@code {
    private bool IsOpen => CosmeticVendorNPC.IsShopOpen && CosmeticVendorNPC.ActiveForLocal != null;
    private string _previewCaseId = "";
    private string _toastMsg    = "";
    private float  _toastUntil = 0f;
    private string _toastCaseId = "";
    private int    _toastCount  = 0;

    private PlayerStats LocalPlayer =>
        Scene?.GetAllComponents<PlayerStats>().FirstOrDefault( p => !p.IsProxy );

    private void Close()
    {
        CosmeticVendorNPC.IsShopOpen = false;
        _previewCaseId = "";
    }

    private void OpenPreview( string caseId ) => _previewCaseId = caseId;
    private void ClosePreview() => _previewCaseId = "";

    private void Buy( string caseId )
    {
        var p = LocalPlayer;
        var vendor = CosmeticVendorNPC.ActiveForLocal;
        if ( p == null || vendor == null ) return;
        p.RequestBuyCase( vendor.GameObject.Id, caseId );
        Sfx.Play( "sounds/shop/purchase.sound", p.WorldPosition );
        var def = vendor.Cases?.FirstOrDefault( c => c.Id == caseId );
        string name = def != null ? L.T( def.NameKey ) : caseId;
        if ( !string.IsNullOrEmpty( _toastMsg ) && _toastCaseId == caseId )
        {
            _toastCount++;
        }
        else
        {
            _toastCount  = 1;
            _toastCaseId = caseId;
        }
        string countSuffix = _toastCount > 1 ? $" ×{_toastCount}" : "";
        _toastMsg   = L.T( "shop2.toast.bought", name ) + countSuffix;
        _toastUntil = Time.Now + 2.8f;
    }

    public class DropChance
    {
        public string CosmeticId;
        public int    CrystalsAmount;  // если > 0 — это currency-дроп без CosmeticCatalog-записи
        public float  ChancePercent;
    }

    private static bool IsValidShopDrop( CaseDropEntry d )
        => d != null && d.Weight > 0f && (!string.IsNullOrEmpty( d.CosmeticId ) || d.CrystalsAmount > 0);

    // Редкость drop'а для сортировки превью. Currency-дропы без CosmeticId
    // (просто CrystalsAmount) — Common.
    private static CosmeticCatalog.Rarity GetShopDropRarity( CaseDropEntry d )
    {
        if ( d == null ) return CosmeticCatalog.Rarity.Common;
        if ( d.CrystalsAmount > 0 && string.IsNullOrEmpty( d.CosmeticId ) )
            return CosmeticCatalog.Rarity.Common;
        var item = CosmeticCatalog.Get( d.CosmeticId );
        return item != null ? item.Rarity : CosmeticCatalog.Rarity.Common;
    }

    private IEnumerable<DropChance> ShopDropsWithChances( CaseDefinition def )
    {
        if ( def == null || def.Drops == null ) yield break;
        float total = 0f;
        foreach ( var d in def.Drops )
            if ( IsValidShopDrop( d ) ) total += d.Weight;
        if ( total <= 0f ) yield break;
        // Сначала по редкости (Legendary → Common), внутри редкости по весу.
        var sorted = def.Drops
            .Where( IsValidShopDrop )
            .OrderByDescending( d => (int)GetShopDropRarity( d ) )
            .ThenByDescending( d => d.Weight );
        foreach ( var d in sorted )
            yield return new DropChance
            {
                CosmeticId     = d.CosmeticId,
                CrystalsAmount = d.CrystalsAmount,
                ChancePercent  = d.Weight / total * 100f,
            };
    }

    // ── Zoom-попап для drop-карточки ─────────────────────────────────────
    private DropChance _zoom;
    private void OpenZoom( DropChance d ) { _zoom = d; }
    private void CloseZoom() { _zoom = null; }
    // Поглощает клик внутри панели, чтобы не закрыть попап кликом по самой карточке.
    private void SwallowClick() { }

    protected override void OnUpdate()
    {
        if ( _toastUntil > 0f && Time.Now > _toastUntil )
        {
            _toastMsg    = "";
            _toastUntil  = 0f;
            _toastCaseId = "";
            _toastCount  = 0;
        }

        if ( IsOpen && Input.EscapePressed )
        {
            // Каскад закрытия: zoom → preview → весь shop.
            if ( _zoom != null )
                CloseZoom();
            else if ( !string.IsNullOrEmpty( _previewCaseId ) )
                ClosePreview();
            else
                Close();
            Input.EscapePressed = false;
        }
    }

    protected override int BuildHash()
    {
        var p = LocalPlayer;
        int casesHash = 0;
        if ( p != null )
            foreach ( var kv in p.AllOwnedCases() )
                casesHash = System.HashCode.Combine( casesHash, kv.Key, kv.Value );
        var vendor = CosmeticVendorNPC.ActiveForLocal;
        return System.HashCode.Combine(
            IsOpen,
            p?.Crystals ?? 0,
            casesHash,
            vendor?.Cases?.Count ?? 0,
            _previewCaseId,
            _zoom?.CosmeticId ?? (_zoom != null ? "$$$" : ""),
            _toastMsg,
            L.Version
        );
    }
}
