@using Sandbox;
@using Sandbox.UI;
@using System.Linq;

@inherits PanelComponent

@*
    Плавающая кнопка-рюкзак в углу экрана. Открывает HubInventoryUI.
    Видна только в хабе (CurrentRoomId == Empty), и когда никакое другое меню не открыто.
*@

<root>
    @if ( IsVisible )
    {
        bool chatOpen = ChatUI.IsOpenStatic;
        string pEvents = chatOpen ? "pointer-events: all; cursor: pointer;" : "pointer-events: none;";
        <div class="hub-btn @(HubInventoryUI.IsOpenStatic ? "active" : "") @(chatOpen ? "clickable" : "")"
             style="@pEvents"
             onclick=@Toggle>
            <span class="hub-btn-label">@L.T("inventory.btn.hint")</span>
            <span class="hub-btn-key">Tab</span>
        </div>
    }
</root>

<style>
    *:active { sound-in: "sounds/tap/tap.sound"; }

    /* ── Design tokens (sync with Code/UI/Design.cs) ── */
    root {
        position: absolute;
        width: 100%;
        height: 100%;
        pointer-events: none;
        font-family: Inter, Roboto, sans-serif;
    }
    .hub-btn {
        position: absolute;
        bottom: 24px;
        right: 24px;
        flex-direction: row;
        align-items: center;
        gap: 10px;
        padding: 10px 14px;
        background-color: #101317;
        border: 1px solid rgba(255,255,255,0.10);
        border-radius: 6px;
        color: #a8b0bb;
        font-size: 13px;
        pointer-events: none;
        transition: background-color 0.12s, border-color 0.12s, color 0.12s;
    }
    .hub-btn.active {
        background-color: rgba(94,163,255,0.10);
        border-color: rgba(94,163,255,0.45);
        color: #5ea3ff;
    }
    .hub-btn.clickable:hover {
        background-color: #161a20;
        border-color: rgba(255,255,255,0.18);
        color: #e7eaee;
    }
    .hub-btn-label {
        font-size: 12px;
        font-weight: 500;
        letter-spacing: 0.5px;
        text-transform: uppercase;
    }
    .hub-btn-key {
        font-size: 11px;
        font-weight: 700;
        color: #6b727d;
        padding: 2px 7px;
        border: 1px solid rgba(255,255,255,0.18);
        border-radius: 4px;
        background-color: #161a20;
    }
    .hub-btn.active .hub-btn-key {
        color: #5ea3ff;
        border-color: rgba(94,163,255,0.45);
    }
</style>

@code {
    PlayerStats LocalPlayer => Scene?.GetAllComponents<PlayerStats>()
        .FirstOrDefault( p => !p.IsProxy );

    bool InHub => LocalPlayer != null && LocalPlayer.CurrentRoomId == System.Guid.Empty;

    // Не показываем кнопку если открыто что-то другое (магазин, settings, конец раунда).
    bool AnotherUiOpen =>
        CosmeticVendorNPC.IsShopOpen ||
        MenuState.SettingsOpen ||
        CaseOpeningUI.IsOpenStatic ||
        TradeUIState.AnyTradeUiOpen;

    bool IsVisible => InHub && !AnotherUiOpen;

    void Toggle()
    {
        if ( !InHub ) { HubInventoryUI.IsOpenStatic = false; return; }
        HubInventoryUI.IsOpenStatic = !HubInventoryUI.IsOpenStatic;
        if ( HubInventoryUI.IsOpenStatic )
            ChatUI.ForceClose();
    }

    protected override void OnAwake()
    {
        // Сбрасываем статику при старте сессии.
        HubInventoryUI.IsOpenStatic = false;
    }

    protected override void OnUpdate()
    {
        if ( !InHub )
        {
            HubInventoryUI.IsOpenStatic = false;
            return;
        }
        if ( AnotherUiOpen )
        {
            HubInventoryUI.IsOpenStatic = false;
            return;
        }

        // Tab (action "score") открывает/закрывает инвентарь в хабе.
        if ( Input.Pressed( "score" ) )
            Toggle();
    }

    protected override int BuildHash()
    {
        return System.HashCode.Combine(
            IsVisible,
            HubInventoryUI.IsOpenStatic,
            ChatUI.IsOpenStatic,
            L.Version
        );
    }
}
