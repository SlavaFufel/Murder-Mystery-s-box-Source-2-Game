@using Sandbox;
@using Sandbox.UI;
@using System.Linq;
@using System.Collections.Generic;

@inherits PanelComponent

@*
    Инвентарь игрока (кейсы + косметика) — доступен только в хабе.
    Открывается клавишей "I" или клик по плавающей кнопке-рюкзаку (HudInventoryButton).
    В рум-играх скрыт (CurrentRoomId != Empty), и кнопка тоже не показывается.
*@

<root>
    @if ( IsVisible && LocalPlayer != null )
    {
        <div class="menu-overlay">
            <div class="menu-panel inventory-panel">
                <div class="header">
                    <div class="header-left">
                        <div class="eyebrow">@L.T("inventory.title")</div>
                    </div>
                    <div class="balance">
                        <span class="balance-glyph">◆</span>
                        <span class="balance-value">@LocalPlayer.Crystals</span>
                    </div>
                </div>

                <div class="tabs">
                    <div class="tab @(_tab == Tab.Cases ? "active" : "")" onclick=@(() => _tab = Tab.Cases)>
                        @L.T("inventory.tab.cases")
                    </div>
                    <div class="tab @(_tab == Tab.Cosmetics ? "active" : "")" onclick=@(() => _tab = Tab.Cosmetics)>
                        @L.T("inventory.tab.cosmetics")
                    </div>
                </div>

                <div class="body">
                    @if ( _tab == Tab.Cases )
                    {
                        var owned = LocalPlayer.AllOwnedCases().ToList();
                        @if ( owned.Count == 0 )
                        {
                            <div class="empty">@L.T("inventory.empty_cases")</div>
                        }
                        else
                        {
                            <div class="grid">
                                @foreach ( var kv in owned )
                                {
                                    var def = FindCaseDefinition( kv.Key );
                                    string nameKey = def?.NameKey ?? ("case." + kv.Key);
                                    string iconPath = def?.IconPath ?? "";
                                    var caseId = kv.Key;
                                    <div class="card">
                                        <div class="card-icon">
                                            @if ( !string.IsNullOrEmpty(iconPath) )
                                            {
                                                <img src="@iconPath" />
                                            }
                                            else
                                            {
                                                <div class="card-icon-fallback">▣</div>
                                            }
                                            <div class="card-count">×@kv.Value</div>
                                        </div>
                                        <div class="card-name">@L.T(nameKey)</div>
                                        <div class="card-btn btn-primary" onclick=@(() => OpenCase(caseId))>
                                            @L.T("shop2.btn.open")
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        var ownedItems = CollectOwnedItems();
                        @if ( ownedItems.Count == 0 )
                        {
                            <div class="empty">@L.T("inventory.empty_cosmetics")</div>
                        }
                        else
                        {
                            <div class="slot-tabs">
                                <div class="slot-tab @(_slotFilter == null ? "active" : "")" onclick=@(() => _slotFilter = null)>
                                    @L.T("inventory.slot.all")
                                </div>
                                <div class="slot-tab @(_slotFilter == CosmeticCatalog.Slot.Nickname ? "active" : "")"
                                     onclick=@(() => _slotFilter = CosmeticCatalog.Slot.Nickname)>
                                    @L.T("inventory.slot.nickname")
                                </div>
                                <div class="slot-tab @(_slotFilter == CosmeticCatalog.Slot.Knife ? "active" : "")"
                                     onclick=@(() => _slotFilter = CosmeticCatalog.Slot.Knife)>
                                    @L.T("inventory.slot.knife")
                                </div>
                                <div class="slot-tab @(_slotFilter == CosmeticCatalog.Slot.Gun ? "active" : "")"
                                     onclick=@(() => _slotFilter = CosmeticCatalog.Slot.Gun)>
                                    @L.T("inventory.slot.gun")
                                </div>
                                <div class="slot-tab @(_slotFilter == CosmeticCatalog.Slot.Hat ? "active" : "")"
                                     onclick=@(() => _slotFilter = CosmeticCatalog.Slot.Hat)>
                                    @L.T("inventory.slot.hat")
                                </div>
                                <div class="slot-tab @(_slotFilter == CosmeticCatalog.Slot.Back ? "active" : "")"
                                     onclick=@(() => _slotFilter = CosmeticCatalog.Slot.Back)>
                                    @L.T("inventory.slot.back")
                                </div>
                                <div class="slot-tab @(_slotFilter == CosmeticCatalog.Slot.Emote ? "active" : "")"
                                     onclick=@(() => _slotFilter = CosmeticCatalog.Slot.Emote)>
                                    @L.T("inventory.slot.emote")
                                </div>
                            </div>

                            @if ( _slotFilter == CosmeticCatalog.Slot.Emote && LocalPlayer != null )
                            {
                                <div class="emote-wheel-preview">
                                    <div class="emote-wheel-title">@L.T("inventory.emote.wheel_title")</div>
                                    <div class="emote-wheel-slots">
                                        @for ( int i = 0; i < PlayerStats.EmoteWheelSize; i++ )
                                        {
                                            var slotIdx = i;
                                            var emoteId = LocalPlayer.GetEmoteSlot( slotIdx );
                                            var item    = CosmeticCatalog.Get( emoteId );
                                            var emoji   = item?.ResourceRef ?? "?";
                                            var isImg   = !string.IsNullOrEmpty( emoji )
                                                          && ( emoji.EndsWith( ".png", System.StringComparison.OrdinalIgnoreCase )
                                                            || emoji.EndsWith( ".jpg", System.StringComparison.OrdinalIgnoreCase )
                                                            || emoji.StartsWith( "images/", System.StringComparison.OrdinalIgnoreCase ) );
                                            <div class="emote-wheel-slot @(_selectedEmoteSlot == slotIdx ? "selected" : "")"
                                                 onclick=@(() => _selectedEmoteSlot = slotIdx)>
                                                <div class="emote-wheel-slot-num">@(slotIdx + 1)</div>
                                                @if ( isImg )
                                                {
                                                    <img class="emote-wheel-slot-img" src="@emoji" />
                                                }
                                                else
                                                {
                                                    <span class="emote-wheel-slot-emoji">@emoji</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                    <div class="emote-wheel-hint">
                                        @( _selectedEmoteSlot >= 0
                                            ? L.T("inventory.emote.hint_pick_emote")
                                            : L.T("inventory.emote.hint_pick_slot") )
                                    </div>
                                </div>
                            }
                            <div class="grid">
                                @foreach ( var item in ownedItems )
                                {
                                    if ( _slotFilter.HasValue && item.Slot != _slotFilter.Value ) continue;

                                    var slotKey = CosmeticCatalog.SlotKey( item.Slot );
                                    bool equipped = LocalPlayer != null && GetEquippedFor( slotKey ) == item.Id;
                                    int ownedCount = LocalPlayer?.OwnedCountOf( slotKey, item.Id ) ?? 1;
                                    var rarityHex = CosmeticCatalog.RarityHexColor( item.Rarity );
                                    var cardStyle = $"border-color: {rarityHex};";
                                    var rarityStyle = $"color: {rarityHex};";
                                    <div class="card" style="@cardStyle">
                                        <div class="card-rarity" style="@rarityStyle">@L.T(CosmeticCatalog.RarityKey(item.Rarity))</div>
                                        <div class="card-icon">
                                            @if ( !string.IsNullOrEmpty(item.IconPath) )
                                            {
                                                <img src="@item.IconPath" />
                                            }
                                            else if ( item.Slot == CosmeticCatalog.Slot.Nickname )
                                            {
                                                <div class="nick @item.ResourceRef">@LocalPlayer.DisplayName
                                                    @if ( item.ResourceRef == "nick-blood" ) {
                                                        <div class="blood-drop bd1"></div>
                                                        <div class="blood-drop bd2"></div>
                                                        <div class="blood-drop bd3"></div>
                                                    }
                                                </div>
                                            }
                                            else if ( item.Slot == CosmeticCatalog.Slot.Emote && !string.IsNullOrEmpty(item.ResourceRef) )
                                            {
                                                var er = item.ResourceRef;
                                                var asImg = er.EndsWith( ".png", System.StringComparison.OrdinalIgnoreCase )
                                                         || er.EndsWith( ".jpg", System.StringComparison.OrdinalIgnoreCase )
                                                         || er.StartsWith( "images/", System.StringComparison.OrdinalIgnoreCase );
                                                if ( asImg )
                                                {
                                                    <img src="@er" />
                                                }
                                                else
                                                {
                                                    <div class="card-icon-fallback">@er</div>
                                                }
                                            }
                                            else
                                            {
                                                <div class="card-icon-fallback">@CosmeticCatalog.SlotEmoji(item.Slot)</div>
                                            }
                                            <div class="card-count">×@ownedCount</div>
                                        </div>
                                        <div class="card-name">@L.T(item.NameKey)</div>
                                        @if ( item.Slot == CosmeticCatalog.Slot.Emote )
                                        {
                                            var assignedSlot = FindEmoteSlotIdx( item.Id );
                                            if ( assignedSlot >= 0 )
                                            {
                                                <div class="card-btn btn-locked">@L.T("inventory.emote.in_slot") @( assignedSlot + 1 )</div>
                                            }
                                            else if ( _selectedEmoteSlot < 0 )
                                            {
                                                <div class="card-btn btn-disabled">@L.T("inventory.emote.pick_slot_first")</div>
                                            }
                                            else
                                            {
                                                <div class="card-btn btn-primary" onclick=@(() => AssignEmote(item.Id))>
                                                    @L.T("inventory.emote.assign") @( _selectedEmoteSlot + 1 )
                                                </div>
                                            }
                                        }
                                        else if ( equipped )
                                        {
                                            // Hat / Back имеют «пустое» состояние слота (hat_none / back_none) —
                                            // их реально можно снять. У ножа/пистолета/ника «дефолт» — это тоже
                                            // конкретная модель, снимать нечего, оставляем locked.
                                            if ( item.Slot == CosmeticCatalog.Slot.Hat || item.Slot == CosmeticCatalog.Slot.Back )
                                            {
                                                <div class="card-btn btn-primary" onclick=@(() => Unequip(slotKey))>
                                                    @L.T("shop2.btn.unequip")
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="card-btn btn-locked">@L.T("shop2.btn.equipped")</div>
                                            }
                                        }
                                        else
                                        {
                                            <div class="card-btn btn-primary" onclick=@(() => Equip(slotKey, item.Id))>
                                                @L.T("shop2.btn.equip")
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>

                <div class="footer">
                    <div class="btn-ghost" onclick=@Close>@L.T("settings.back")</div>
                </div>
            </div>
        </div>
    }
</root>

<style>
    *:active { sound-in: "sounds/tap/tap.sound"; }

    /* ── Design tokens (sync with Code/UI/Design.cs) ──
       bg-0 #0b0d10  bg-1 #101317  bg-2 #161a20
       border rgba(255,255,255,0.10)
       text-1 #e7eaee  text-2 #a8b0bb  text-3 #6b727d
       accent #5ea3ff
       r-sm 6px  r-md 12px
    */

    root {
        position: absolute;
        width: 100%;
        height: 100%;
        pointer-events: none;
        font-family: Inter, Roboto, sans-serif;
        color: #e7eaee;
    }

    .menu-overlay {
        position: absolute;
        width: 100%;
        height: 100%;
        background-color: rgba(11,13,16,0.72);
        backdrop-filter: blur(8px);
        align-items: center;
        justify-content: center;
        pointer-events: all;
    }

    .inventory-panel {
        flex-direction: column;
        width: 920px;
        max-width: 92%;
        max-height: 86%;
        padding: 20px 24px;
        background-color: #101317;
        border: 1px solid rgba(255,255,255,0.10);
        border-radius: 12px;
        gap: 16px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.4);
    }

    /* ── Header ── */
    .header {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding-bottom: 12px;
        border-bottom: 1px solid rgba(255,255,255,0.06);
    }
    .header-left { flex-direction: column; gap: 2px; }
    .eyebrow {
        color: #6b727d;
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 0.5px;
        text-transform: uppercase;
    }
    .balance {
        flex-direction: row;
        align-items: center;
        gap: 6px;
    }
    .balance-glyph {
        color: #5ea3ff;
        font-size: 14px;
    }
    .balance-value {
        color: #e7eaee;
        font-size: 16px;
        font-weight: 700;
    }

    /* ── Tabs (Cases / Cosmetics) ── */
    .tabs {
        flex-direction: row;
        gap: 6px;
    }
    .tab {
        flex-grow: 1;
        padding: 10px 14px;
        background-color: transparent;
        border: 1px solid rgba(255,255,255,0.10);
        border-radius: 6px;
        color: #a8b0bb;
        font-size: 13px;
        font-weight: 500;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        text-align: center;
        cursor: pointer;
        transition: background-color 0.12s, border-color 0.12s, color 0.12s;
    }
    .tab:hover {
        background-color: #161a20;
        border-color: rgba(255,255,255,0.18);
        color: #e7eaee;
    }
    .tab.active {
        background-color: rgba(94,163,255,0.10);
        border-color: rgba(94,163,255,0.45);
        color: #5ea3ff;
    }

    /* ── Slot tabs (filter buttons inside cosmetics) ── */
    .slot-tabs {
        flex-direction: row;
        flex-wrap: wrap;
        gap: 6px;
        padding: 4px 0 10px 0;
    }
    .slot-tab {
        padding: 6px 14px;
        background-color: transparent;
        border: 1px solid rgba(255,255,255,0.10);
        border-radius: 6px;
        color: #a8b0bb;
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        cursor: pointer;
        transition: background-color 0.12s, border-color 0.12s, color 0.12s;
    }
    .slot-tab:hover {
        background-color: #161a20;
        border-color: rgba(255,255,255,0.18);
        color: #e7eaee;
    }
    .slot-tab.active {
        background-color: rgba(94,163,255,0.10);
        border-color: rgba(94,163,255,0.45);
        color: #5ea3ff;
    }

    /* ── Body ── */
    .body { flex-direction: column; }
    .empty {
        flex-grow: 1;
        align-items: center;
        justify-content: center;
        color: #6b727d;
        font-size: 14px;
        text-align: center;
        padding: 40px;
    }

    /* ── Grid of cards ── */
    .grid {
        flex-direction: row;
        flex-wrap: wrap;
        gap: 12px;
        align-content: flex-start;
        padding-bottom: 8px;
        max-height: 560px;
        overflow: scroll;
        pointer-events: all;
    }
    .card {
        flex-direction: column;
        flex-shrink: 0;
        width: 200px;
        padding: 14px;
        background-color: #161a20;
        border: 1px solid rgba(255,255,255,0.10);
        border-radius: 12px;
        gap: 10px;
        align-items: center;
        transition: border-color 0.12s;
    }
    .card-rarity {
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        text-align: center;
    }
    .card-icon {
        width: 160px;
        height: 120px;
        background-color: #0b0d10;
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 6px;
        align-items: center;
        justify-content: center;
        position: relative;
        overflow: hidden;
    }
    .card-icon img { width: 160px; height: 150px; margin-top: -16px; }
    .card-icon-fallback {
        font-size: 36px;
        color: #6b727d;
    }
    .card-count {
        position: absolute;
        right: 6px;
        bottom: 6px;
        background-color: #161a20;
        border: 1px solid rgba(255,255,255,0.10);
        color: #e7eaee;
        font-weight: 700;
        font-size: 11px;
        padding: 2px 7px;
        border-radius: 4px;
    }
    .card-name {
        color: #e7eaee;
        font-size: 13px;
        font-weight: 500;
        text-align: center;
    }
    .card-btn {
        width: 100%;
        padding: 8px 12px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        text-align: center;
        cursor: pointer;
        transition: background-color 0.12s, border-color 0.12s, color 0.12s;
    }
    .btn-primary {
        background-color: #5ea3ff;
        border: 1px solid #5ea3ff;
        color: #0b0d10;
    }
    .btn-primary:hover  { background-color: #7eb6ff; border-color: #7eb6ff; }
    .btn-primary:active { background-color: #3f8ce8; border-color: #3f8ce8; }
    .btn-locked {
        background-color: transparent;
        border: 1px solid rgba(78,192,122,0.45);
        color: #4ec07a;
        cursor: default;
    }
    .btn-disabled {
        background-color: transparent;
        border: 1px solid rgba(255,255,255,0.10);
        color: #6b727d;
        cursor: default;
    }

    /* ── Превью колеса эмоций (вкладка Emotes) ── */
    .emote-wheel-preview {
        flex-direction: column;
        align-items: center;
        gap: 10px;
        padding: 14px 18px;
        margin-bottom: 16px;
        background-color: #101317;
        border: 1px solid rgba(255,255,255,0.10);
        border-radius: 12px;
    }
    .emote-wheel-title {
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: #a8b0bb;
    }
    .emote-wheel-slots {
        flex-direction: row;
        gap: 10px;
    }
    .emote-wheel-slot {
        width: 78px;
        height: 78px;
        border-radius: 39px;
        background-color: #161a20;
        border: 2px solid rgba(255,255,255,0.12);
        align-items: center;
        justify-content: center;
        position: relative;
        cursor: pointer;
        transition: border-color 0.12s, transform 0.12s, background-color 0.12s;
    }
    .emote-wheel-slot:hover {
        border-color: rgba(94,163,255,0.55);
        transform: scale(1.05);
    }
    .emote-wheel-slot.selected {
        border-color: #5ea3ff;
        background-color: rgba(94,163,255,0.10);
        transform: scale(1.08);
    }
    .emote-wheel-slot-num {
        position: absolute;
        top: 4px;
        left: 8px;
        font-size: 10px;
        font-weight: 700;
        color: #6b727d;
    }
    .emote-wheel-slot-emoji {
        font-size: 36px;
        line-height: 36px;
    }
    .emote-wheel-slot-img {
        width: 48px;
        height: 48px;
    }
    .emote-wheel-hint {
        font-size: 12px;
        color: #a8b0bb;
        letter-spacing: 0.5px;
    }

    /* ── Ник-метки (косметика — не minimal chrome, оставлены как есть) ── */
    .nick {
        font-size: 14px;
        font-weight: 700;
        letter-spacing: 1px;
        padding: 3px 10px;
        border-radius: 8px;
        color: white;
        background-color: rgba(0,0,0,0.55);
        border: 1px solid rgba(255,255,255,0.18);
        text-shadow: 0 1px 2px rgba(0,0,0,0.9);
        position: relative;
        text-align: center;
    }
    .blood-drop {
        position: absolute;
        background-color: #8a0303;
        width: 3px;
        border-radius: 0 0 3px 3px;
        pointer-events: none;
        bottom: -2px;
        height: 2px;
    }
    .blood-drop.bd1 { left: 20%; animation: blood-drip 2.0s ease-in 0s infinite; }
    .blood-drop.bd2 { left: 52%; animation: blood-drip 2.5s ease-in 0.8s infinite; }
    .blood-drop.bd3 { left: 76%; animation: blood-drip 1.9s ease-in 1.4s infinite; }
    @@keyframes blood-drip {
        0%   { height: 2px; opacity: 0.9; transform: translateY(0); }
        25%  { height: 7px; }
        75%  { opacity: 0.7; }
        100% { height: 8px; transform: translateY(24px); opacity: 0; }
    }
    .nick-default {}
    .nick-chalk      { color: #f0f0f0; font-family: "Comic Sans MS", "Marker Felt", cursive; text-shadow: 0 0 1px rgba(255,255,255,0.4); }
    .nick-typewriter { color: #1a1a1a; background-color: rgba(245,245,235,0.92); font-family: "Courier New", monospace; border: 1px solid #555; }
    .nick-cinema     { color: #ffe9b8; font-style: italic; text-shadow: 2px 2px 4px rgba(0,0,0,1); }
    .nick-neon-blue  { color: #a8efff; background-color: rgba(0,15,30,0.7); border: 1px solid rgba(80,200,255,0.7); text-shadow: 0 0 8px #4ad8ff, 0 0 16px #4ad8ff; animation: nick-neon-pulse 1.4s ease-in-out infinite; }
    .nick-neon-pink  { color: #ffb8e6; background-color: rgba(30,0,20,0.7); border: 1px solid rgba(255,80,200,0.7); text-shadow: 0 0 8px #ff4ad8, 0 0 16px #ff4ad8; animation: nick-neon-pulse 1.6s ease-in-out infinite; }
    .nick-police     { color: white; background: linear-gradient(90deg, rgba(220,40,40,0.85) 0%, rgba(40,80,220,0.85) 100%); border: 1px solid rgba(255,255,255,0.5); animation: nick-police-flash 0.9s ease-in-out infinite; }
    .nick-glitch     { color: #cffafa; background-color: rgba(0,0,0,0.78); border: 1px solid rgba(255,80,180,0.6); text-shadow: 2px 0 0 #ff00aa, -2px 0 0 #00ffff; animation: nick-glitch-shake 0.45s infinite; }
    .nick-blood      { color: #ff4040; background-color: rgba(20,0,0,0.85); border: 1px solid rgba(255,40,40,0.7); text-shadow: 0 0 6px #c00000, 0 2px 4px rgba(120,0,0,0.9); animation: nick-blood-pulse 1.8s ease-in-out infinite; }
    .nick-ghost      { color: rgba(220,235,255,0.85); background-color: rgba(40,50,80,0.4); border: 1px solid rgba(180,200,255,0.4); text-shadow: 0 0 8px rgba(200,220,255,0.7); animation: nick-ghost-fade 2.4s ease-in-out infinite; }
    .nick-suspect    { color: #ffd700; background-color: rgba(40,30,0,0.85); border: 2px solid rgba(255,215,0,0.85); text-shadow: 0 0 10px #ffaa00, 0 0 20px #ffd700; animation: nick-suspect-shine 2s ease-in-out infinite; }
    .nick-justice    { color: #fff7c0; background: linear-gradient(90deg, rgba(80,60,0,0.85), rgba(180,140,0,0.85), rgba(80,60,0,0.85)); border: 2px solid #ffd700; text-shadow: 0 0 10px #ffd700, 0 0 18px #ffaa00; animation: nick-justice-shimmer 1.6s ease-in-out infinite; }
    .nick-ash        { color: #d8d2cc; background-color: rgba(20,10,5,0.85); border: 2px solid rgba(80,60,55,0.7); text-shadow: 0 -2px 6px rgba(255,140,60,0.6), 0 2px 4px rgba(120,40,0,0.7); animation: nick-ash-flicker 1.4s ease-in-out infinite; }
