@code {
    public enum Tab { Cases, Cosmetics }
    private Tab _tab = Tab.Cosmetics;
    private CosmeticCatalog.Slot? _slotFilter = null;

    // Выбранный слот колеса (0..5) на вкладке Emotes. -1 = ещё не выбрано.
    // После клика по эмоции — она ставится в этот слот.
    private int _selectedEmoteSlot = -1;

    /// <summary>Глобальный флаг открытия — переключается из HubInventoryButton.</summary>
    public static bool IsOpenStatic { get; set; } = false;

    /// <summary>Игрок в хабе если CurrentRoomId == Empty.</summary>
    private bool InHub
    {
        get
        {
            var p = LocalPlayer;
            return p != null && p.CurrentRoomId == System.Guid.Empty;
        }
    }

    private bool IsVisible => IsOpenStatic && InHub;

    private PlayerStats LocalPlayer =>
        Scene?.GetAllComponents<PlayerStats>().FirstOrDefault( p => !p.IsProxy );

    private void Close() => IsOpenStatic = false;

    private void OpenCase( string caseId )
    {
        if ( LocalPlayer == null || string.IsNullOrEmpty( caseId ) ) return;
        if ( LocalPlayer.GetCaseCount( caseId ) <= 0 ) return;
        IsOpenStatic = false;
        CaseOpeningUI.Open( caseId );
    }

    private void Equip( string slot, string itemId )
    {
        var p = LocalPlayer;
        if ( p == null ) return;
        p.RequestEquipCosmetic( slot, itemId );
    }

    // Возвращает слот к «пустому» состоянию (hat_none / back_none).
    // ApplyClothing() сам пересоберёт аватара без снятой косметики
    // (см. RequestEquipCosmetic — он триггерит ApplyClothing при itemId == default).
    private void Unequip( string slot )
    {
        var p = LocalPlayer;
        if ( p == null || string.IsNullOrEmpty( slot ) ) return;
        var parsed = CosmeticCatalog.ParseSlot( slot );
        if ( !parsed.HasValue ) return;
        var defaultId = CosmeticCatalog.DefaultIdForSlot( parsed.Value );
        if ( string.IsNullOrEmpty( defaultId ) ) return;
        p.RequestEquipCosmetic( slot, defaultId );
    }

    // Поставить эмоцию в выбранный слот колеса. После — сбрасываем
    // выбор слота, чтобы не пихнуть случайно ещё что-то.
    private void AssignEmote( string emoteId )
    {
        var p = LocalPlayer;
        if ( p == null || _selectedEmoteSlot < 0 ) return;
        if ( string.IsNullOrEmpty( emoteId ) ) return;
        p.RequestSetEmoteSlot( _selectedEmoteSlot, emoteId );
        _selectedEmoteSlot = -1;
    }

    // Если эмоция уже стоит в каком-то слоте колеса — возвращаем индекс,
    // иначе -1. Используется чтобы показать "В СЛОТЕ 3" на карточке.
    private int FindEmoteSlotIdx( string emoteId )
    {
        var p = LocalPlayer;
        if ( p == null || string.IsNullOrEmpty( emoteId ) ) return -1;
        for ( int i = 0; i < PlayerStats.EmoteWheelSize; i++ )
            if ( p.GetEmoteSlot( i ) == emoteId ) return i;
        return -1;
    }

    private List<CosmeticCatalog.Item> CollectOwnedItems()
    {
        var result = new List<CosmeticCatalog.Item>();
        var p = LocalPlayer;
        if ( p == null ) return result;
        foreach ( var item in CosmeticCatalog.All )
        {
            // knife_default / gun_default показываем всегда — игрок может вернуться к дефолту.
            // back_none / hat_none / nick_default — это «пустые» состояния слота, их в инвентаре не показываем.
            if ( item.Id == "back_none" || item.Id == "hat_none" || item.Id == "nick_default" ) continue;
            // Currency-дропы не предметы — выпавшие кристаллы сразу зачисляются на баланс.
            if ( item.Slot == CosmeticCatalog.Slot.Currency ) continue;
            var slot = CosmeticCatalog.SlotKey( item.Slot );
            if ( p.IsOwned( slot, item.Id ) )
                result.Add( item );
        }

        // Страховка от ситуации, когда какой-то build не подхватил IsOwned-проверку
        // для виртуальных дефолтов — вручную добавляем их если они есть в каталоге
        // и ещё не в результате.
        EnsureVirtualDefault( result, "knife_default" );
        EnsureVirtualDefault( result, "gun_default" );

        return result;
    }

    private static void EnsureVirtualDefault( List<CosmeticCatalog.Item> list, string id )
    {
        if ( list.Any( x => x?.Id == id ) ) return;
        var item = CosmeticCatalog.Get( id );
        if ( item != null ) list.Add( item );
    }

    private string GetEquippedFor( string slot )
    {
        var p = LocalPlayer;
        if ( p == null || string.IsNullOrEmpty( slot ) ) return "";
        foreach ( var pair in (p.EquippedCosmeticsSerialized ?? "").Split( ';', System.StringSplitOptions.RemoveEmptyEntries ) )
        {
            var idx = pair.IndexOf( ':' );
            if ( idx <= 0 ) continue;
            if ( pair.Substring( 0, idx ) == slot ) return pair.Substring( idx + 1 );
        }
        return "";
    }

    private CaseDefinition FindCaseDefinition( string caseId )
    {
        if ( string.IsNullOrEmpty( caseId ) ) return null;
        // Стартовый кейс определён в коде — не ищем у вендоров.
        var starter = StarterCase.Get( caseId );
        if ( starter != null ) return starter;
        if ( Scene == null ) return null;
        foreach ( var v in Scene.GetAllComponents<CosmeticVendorNPC>() )
        {
            if ( v.Cases == null ) continue;
            var d = v.Cases.FirstOrDefault( c => c.Id == caseId );
            if ( d != null ) return d;
        }
        return null;
    }

    protected override void OnAwake()
    {
        // Статическое поле сохраняется между сессиями Play — сбрасываем.
        IsOpenStatic = false;
    }

    protected override void OnUpdate()
    {
        // В рум-играх инвентарь автоматически закрывается.
        if ( IsOpenStatic && !InHub ) IsOpenStatic = false;

        if ( IsVisible && Input.EscapePressed )
        {
            Close();
            Input.EscapePressed = false;
        }
    }

    protected override int BuildHash()
    {
        var p = LocalPlayer;
        int casesHash = 0;
        if ( p != null )
            foreach ( var kv in p.AllOwnedCases() )
                casesHash = System.HashCode.Combine( casesHash, kv.Key, kv.Value );
        return System.HashCode.Combine(
            IsVisible,
            _tab,
            _slotFilter,
            p?.Crystals ?? 0,
            p?.EquippedCosmeticsSerialized?.GetHashCode() ?? 0,
            casesHash,
            L.Version
        );
    }
}
