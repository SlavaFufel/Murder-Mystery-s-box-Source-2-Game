@using Sandbox;
@using Sandbox.UI;
@using System.Linq;

@inherits PanelComponent

@*
    Кнопка-индикатор обмена между игроками. Расположена над кнопкой промо.
    Открывает список игроков в хабе для отправки приглашения. Если приходит
    приглашение или открыто окно сделки — индикатор подсвечивается accent.
*@

<root>
    @if ( IsVisible )
    {
        bool chatOpen = ChatUI.IsOpenStatic;
        string pEvents = chatOpen ? "pointer-events: all; cursor: pointer;" : "pointer-events: none;";
        <div class="hub-btn tr-btn @(TradeUIState.IsListOpen ? "active" : "") @(HasIncoming() ? "ready" : "") @(chatOpen ? "clickable" : "")"
             style="@pEvents"
             onclick=@Toggle>
            <span class="hub-btn-label">@L.T("trade.btn.hint")</span>
            <span class="hub-btn-key">K</span>
            @if ( HasIncoming() )
            {
                <span class="hub-btn-dot"></span>
            }
        </div>
    }
</root>

<style>
    /* ── Design tokens (sync with Code/UI/Design.cs) ── */
    root {
        position: absolute;
        width: 100%;
        height: 100%;
        pointer-events: none;
        font-family: Inter, Roboto, sans-serif;
    }
    .hub-btn {
        position: absolute;
        right: 24px;
        flex-direction: row;
        align-items: center;
        gap: 10px;
        padding: 10px 14px;
        background-color: #101317;
        border: 1px solid rgba(255,255,255,0.10);
        border-radius: 6px;
        color: #a8b0bb;
        pointer-events: none;
        transition: background-color 0.12s, border-color 0.12s, color 0.12s;
    }
    .tr-btn { bottom: 168px; }
    .hub-btn.active {
        background-color: rgba(94,163,255,0.10);
        border-color: rgba(94,163,255,0.45);
        color: #5ea3ff;
    }
    .hub-btn.ready {
        border-color: rgba(94,163,255,0.45);
    }
    .hub-btn.clickable:hover {
        background-color: #161a20;
        border-color: rgba(255,255,255,0.18);
        color: #e7eaee;
    }
    .hub-btn-label {
        font-size: 12px;
        font-weight: 500;
        letter-spacing: 0.5px;
        text-transform: uppercase;
    }
    .hub-btn-key {
        font-size: 11px;
        font-weight: 700;
        color: #6b727d;
        padding: 2px 7px;
        border: 1px solid rgba(255,255,255,0.18);
        border-radius: 4px;
        background-color: #161a20;
    }
    .hub-btn.active .hub-btn-key {
        color: #5ea3ff;
        border-color: rgba(94,163,255,0.45);
    }
    .hub-btn-dot {
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background-color: #5ea3ff;
        animation: hub-pulse 1.2s ease-in-out infinite;
    }
    @@keyframes hub-pulse {
        0%, 100% { opacity: 1;   transform: scale(1); }
        50%      { opacity: 0.5; transform: scale(0.7); }
    }
</style>

@code {
    PlayerStats LocalPlayer => Scene?.GetAllComponents<PlayerStats>()
        .FirstOrDefault( p => !p.IsProxy );

    bool InHub => LocalPlayer != null && LocalPlayer.CurrentRoomId == System.Guid.Empty;

    bool AnotherUiOpen =>
        CosmeticVendorNPC.IsShopOpen ||
        MenuState.SettingsOpen ||
        CaseOpeningUI.IsOpenStatic ||
        HubInventoryUI.IsOpenStatic ||
        DailyRewardsUIState.IsOpen ||
        PromoCodeUIState.IsOpen;

    bool IsVisible => InHub && (!AnotherUiOpen || TradeUIState.IsListOpen);

    bool HasIncoming() =>
        !string.IsNullOrEmpty( TradeManager.IncomingInviteFromSteamId )
        || TradeManager.CurrentSession != null;

    void Toggle()
    {
        if ( !InHub ) { TradeUIState.IsListOpen = false; return; }
        // Если уже идёт сделка / есть приглашение — клик по кнопке ничего не делает,
        // соответствующий UI уже виден.
        if ( TradeManager.CurrentSession != null ) return;
        if ( !string.IsNullOrEmpty( TradeManager.IncomingInviteFromSteamId ) ) return;
        TradeUIState.IsListOpen = !TradeUIState.IsListOpen;
        if ( TradeUIState.IsListOpen )
            ChatUI.ForceClose();
    }

    protected override void OnUpdate()
    {
        if ( !InHub )
        {
            TradeUIState.IsListOpen = false;
            return;
        }

        // [K] — переключатель окна обмена. Игнорируем когда открыты другие меню.
        if ( Input.Pressed( "Trade" ) && (!AnotherUiOpen || TradeUIState.IsListOpen) )
            Toggle();
    }

    protected override int BuildHash()
    {
        return System.HashCode.Combine(
            IsVisible,
            TradeUIState.IsListOpen,
            TradeManager.Version,
            ChatUI.IsOpenStatic,
            L.Version
        );
    }
}
